Rel(api, posbackend, "Маршрутизация")
Rel(posbackend, clouddb, "Чтение/запись", "SQL")
Rel(posbackend, cache, "Кэш каталога/промо")
Rel(posbackend, paymentgw, "Инициирует платёж")
Rel(posbackend, loyalty, "Начисление/списание баллов", "HTTPS")
Rel(posbackend, messagebus, "События чеков")
Rel(sync, clouddb, "Идемпотентная запись чеков")
Rel(sync, messagebus, "Reconciliation-события")
Rel(onboarding, skumatcher, "Отправляет дамп на матчинг")
Rel(onboarding, verifyui, "Публикует очередь Medium/Low")
Rel(onboarding, preflight, "Запускает pre-flight")
Rel(onboarding, clouddb, "Пишет утверждённые маппинги")
Rel(onboarding, posbackend, "Деплой конфигурации магазина")
Rel(skumatcher, clouddb, "Читает эталон, пишет score")
Rel(verifyui, clouddb, "Обновляет маппинги")
Rel(preflight, posbackend, "Проверка каталога/ШК/цены")
Rel(postopen, monitoring, "Метрики ошибок ШК")
Rel(postopen, onboarding, "Триггер обратного маппинга (>2%)")
Rel(paymentgw, acquirer, "Авторизация/возврат", "HTTPS")
Rel(posbackend, fns, "Фискализация", "HTTPS")
Rel(api, idp, "Валидация токенов", "OIDC")

' ===== Связи HQ =====
Rel(sap, clouddb, "CDC номенклатуры/цен")
Rel(sap, promo, "Условия акций")
Rel(sap, fulfillment, "Остатки")
Rel(fulfillment, wms, "Остатки и перемещения", "API")
Rel(sap, marketing, "Сегменты для рассылок", "API")
Rel(merch, verifyui, "Верифицирует Medium/Low")
Rel(iteng, onboarding, "Загружает дамп купленной сети")
Rel(ops, monitoring, "Дашборды и алерты")

' ===== Аннотации =====
note right of hal
  **HAL**: кассовый софт не знает про USB/COM.
  Новый терминал = новый драйвер (INC-8415:
  ARCUS-2 решается за дни, не 3 недели).
end note

note right of localcache
  **Offline**: Service Worker + IndexedDB.
  Кэшируются каталог, промо И баланс лояльности
  → закрывает INC-8402 (карты работают офлайн).
end note

note bottom of onboarding
  **Онбординг 14д → 5д**: оркестратор +
  SKU Matcher (75% авто) + Verification UI
  (25% ручной, ускорение x4) + pre-flight 98%
end note

note bottom of sync
  **Идемпотентность**: client_txn_id (UUID с планшета)
  исключает дубли. Конфликты — last-write-wins
  по версии каталога + журнал операций.
end note

note bottom of paymentgw
  **Payment Gateway**: единый контракт
  authorize/capture/refund. Смена банка = конфиг.
end note

note top of edgeagent
  Edge Agent = локальный сервис на планшете
  (Android USB-host) или на дешёвом Edge Node.
  В облаке не нужен — работает при offline.
end note

@enduml